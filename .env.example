# Server Configuration
PORT=3000
NODE_ENV=development

# Data Source: "auto" (uses Supabase when configured, otherwise local SQLite mirror), "supabase", or "sqlite"
DATA_SOURCE=auto

# Supabase Configuration (Required for Supabase cloud mode)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional AI LLM API Keys (Rewardly includes a built-in intelligent analytics engine even without external keys)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Exposed Date-Range Export API Token (configurable in Settings UI)
PUBLIC_EXPORT_TOKEN=rw_live_kaveri_2026
REQUIRE_EXPORT_TOKEN=false

